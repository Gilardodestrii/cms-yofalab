# Contoh konfigurasi lingkungan YOFALAB CMS.
# Salin ke `.env` lalu sesuaikan nilainya. JANGAN commit file `.env`.

# --- Wajib ---
# Koneksi MySQL 8. Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="mysql://yofalab:RAHASIA@127.0.0.1:3306/yofalab"

# Kunci penandatanganan sesi NextAuth + salt hash IP komentar/pesan.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-32-karakter-acak"

# URL publik situs. Dipakai untuk metadata, canonical, sitemap, dan tautan.
NEXT_PUBLIC_SITE_URL="https://yofalab.com"

# --- Opsional ---
NODE_ENV="production"

# Direktori penyimpanan unggahan (relatif terhadap root proyek).
UPLOAD_DIR="uploads"

# Batas ukuran unggahan dalam byte (default 5242880 = 5 MB).
MAX_UPLOAD_BYTES="5242880"

# --- SMTP notifikasi pesan kontak (opsional) ---
# Bila SMTP_HOST atau MAIL_FROM kosong, email dilewati dan pesan tetap tersimpan.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Penerima notifikasi. Bila kosong, nilai dari /admin/settings dipakai.
MAIL_TO=""

# --- Seed Super Admin pertama (dipakai `npm run db:seed` saja) ---
SEED_ADMIN_EMAIL="admin@yofalab.com"
SEED_ADMIN_PASSWORD="ganti-kata-sandi-ini"
SEED_ADMIN_NAME="Super Admin"
